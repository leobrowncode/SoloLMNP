{
  "name": "sololmnp-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
