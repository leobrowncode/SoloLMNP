FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

ARG APP_UID=1000
ARG APP_GID=1000
RUN groupadd --gid "$APP_GID" sololmnp \
    && useradd --uid "$APP_UID" --gid "$APP_GID" --no-create-home sololmnp \
    && mkdir -p /app/backend /app/data/documents /app/scripts \
    && chown -R sololmnp:sololmnp /app/data

WORKDIR /app/backend
COPY backend/requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
COPY backend/pyproject.toml ./
COPY backend/app ./app
COPY backend/alembic.ini ./
COPY backend/alembic ./alembic
RUN pip install --no-cache-dir --no-deps --no-build-isolation .
COPY fiscal /app/fiscal
COPY scripts/start-backend.sh /app/scripts/start-backend.sh
RUN sed -i 's/\r$//' /app/scripts/start-backend.sh

USER sololmnp:sololmnp
EXPOSE 8000
ENTRYPOINT ["/bin/sh", "/app/scripts/start-backend.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
