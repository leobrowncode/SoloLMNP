{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "installCommand": "python3 -m pip install -r backend/requirements.lock && npm ci --include=dev --prefix frontend",
  "buildCommand": "python3 scripts/vercel_build.py",
  "functions": {
    "asgi.py": {
      "maxDuration": 300,
      "includeFiles": ["fiscal/**", "lmnp_core/**", "golden/**"],
      "excludeFiles": "{frontend/node_modules/**,e2e/**,backend/tests/**,docs/**,**/.venv/**,**/.pytest-tmp/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
