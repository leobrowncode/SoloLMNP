# Optional Docker Compose overrides. Defaults work without creating .env.
SOLOLMNP_PORT=5173
SOLOLMNP_DATA_DIR=./data
# Linux only: match the owner of ./data (id -u / id -g), then rebuild.
SOLOLMNP_UID=1000
SOLOLMNP_GID=1000
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Native development: copied to .env at the repository root.
# Relative database/document paths are resolved from the repository root.
# Compose intentionally uses fixed internal paths instead of these values.
APP_ENV=development
DATABASE_URL=sqlite:///data/sololmnp.sqlite3
DOCUMENTS_DIR=data/documents
CORS_ORIGINS=[]
MAX_UPLOAD_BYTES=10485760
