# Optional Docker Compose overrides. Defaults work without creating .env.
SOLOLMNP_PORT=5173
SOLOLMNP_DATA_DIR=./data
# Linux only: match the owner of ./data (id -u / id -g), then rebuild.
SOLOLMNP_UID=1000
SOLOLMNP_GID=1000
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Native development: copied to .env at the repository root.
# Relative database/document paths are resolved from the repository root.
# Compose intentionally uses fixed internal paths instead of these values.
# Postgres (Neon): see docs/POSTGRES.md. Migrations want the direct URL;
# the running app can use the pooled host. Example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Vercel only. Leave unset for the local launcher and Docker. See docs/DEPLOYMENT.md.
# DATABASE_URL_UNPOOLED is the direct Neon URL (no -pooler) used by Alembic at deploy.
# SOLOLMNP_PRODUCTION_DB_HOST is the production direct host, Preview only, no password.
# VERCEL_FASTAPI_STATIC_CDN=1 promotes the Vite build to the CDN.
APP_ENV=development
DATABASE_URL=sqlite:///data/sololmnp.sqlite3
DOCUMENTS_DIR=data/documents
# Magasin Vercel Blob privé. Vide : les justificatifs restent dans DOCUMENTS_DIR.
# Le jeton ne part pas vers le navigateur. Le téléchargement passe par l’API.
BLOB_READ_WRITE_TOKEN=
CORS_ORIGINS=[]
MAX_UPLOAD_BYTES=10485760

# Neon Auth (managed Better Auth). No secret belongs in this file.
# The API checks the JWT against the JWKS. The browser uses the same Auth URL.
# ALLOWED_EMAILS is a comma-separated allowlist. An empty list refuses everyone.
# NEON_AUTH_BASE_URL=https://ep-example.neonauth.c-3.us-east-1.aws.neon.tech/neondb/auth
# NEON_AUTH_JWKS_URL=https://ep-example.neonauth.c-3.us-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
# VITE_NEON_AUTH_URL=https://ep-example.neonauth.c-3.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
VITE_NEON_AUTH_URL=
ALLOWED_EMAILS=
# Dossier local, sans secret Neon. Un seul compte (sujet sololmnp-local).
# Refusé si APP_ENV=production ou si VERCEL=1. Pour Neon Auth : AUTH_MODE=neon et les URL ci-dessus.
AUTH_MODE=local
VITE_AUTH_MODE=local
# Tests and the browser journey only. Refused when APP_ENV=production or on Vercel.
# AUTH_MODE=test
# AUTH_TEST_SECRET=
